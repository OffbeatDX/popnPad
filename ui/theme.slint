export global Theme {
    out property <length> radius-sm: 2px;
    out property <length> radius-lg: 6px;

    out property <color> bg:       #0a0a0c;
    out property <color> surface:  #121214;
    out property <color> surface2: #1a1a1e;
    out property <color> border:   #2e2e34;
    out property <color> text1:    #f0f0f2;
    out property <color> text2:    #b0b0b8;
    out property <color> text3:    #6e6e78;

    out property <color> plate:      #17171c;
    out property <color> plate-edge: #33333c;
    out property <color> socket:     #101014;

    out property <color> pop-white:  #eef0f2;
    out property <color> pop-yellow: #ffd400;
    out property <color> pop-green:  #3fd24a;
    out property <color> pop-blue:   #2f9dff;
    out property <color> pop-red:    #ff3b47;
    out property <color> pop-kun-l:  #ff2d55;
    out property <color> pop-kun-r:  #2b6fff;

    in-out property <color> accent-a: #ff4d94;
    in-out property <color> accent-b: #ffcc33;
    out property <brush> accent-grad: @linear-gradient(120deg, accent-a, accent-b);

    out property <color> text-on-accent: #0a0a0c;
    out property <color> ok: #2ecc71;
    out property <color> bad: #e74c3c;
    out property <color> danger-hover: #9c2b43;
}
